# MQTT Broker Settings
MQTT_HOST=broker.hivemq.com
MQTT_PORT=1883
MQTT_TOPIC=yourcustomtopic

# Device Settings
DEVICE_ID=E001
CAMERA_ID=0

# Camera Settings
TRAIN_IMAGE_SIZE=640
INFERENCE_IMAGE_SIZE=320
YOLO_AI_MODEL_PASS=yolo26n.pt
ELEVATOR_AI_MODEL_PASS=elevatorTrackerv7.pt

# Power / display
INFERENCE_INTERVAL_SEC=0.5
HEADLESS=false

# Hard-example local queue (active learning)
HARD_EXAMPLE_ENABLED=true
HARD_CONF_LOW=0.25
HARD_CONF_HIGH=0.65
HARD_MISS_FRAMES=5
HARD_MIN_INTERVAL_SEC=3.0
HARD_FLOOR_JUMP_THRESHOLD=2
HARD_EXAMPLE_DIR=data/hard_examples
DAILY_UPLOAD_BUDGET_BYTES=5242880
HARD_JPEG_QUALITY=70
HARD_MAX_LONG_EDGE=320

# Upload stub (keep false until HTTPS server is ready)
UPLOAD_ENABLED=false
UPLOAD_URL=
UPLOAD_TIMEOUT_SEC=30
